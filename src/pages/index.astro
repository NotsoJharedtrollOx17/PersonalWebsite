---
/**
 * Page component that is the default landing page (Home) 
 * of the website. THIS IS Astro's STARTING POINT.  * DO NOT DELETE!
 */

import BaseLayout from "@layouts/BaseLayout.astro";
import LocalNavLink from "@components/LocalNavLink.astro";
import ColorThemeToogle from "@components/ColorThemeToogle.astro";
import ContactInformation from "@components/ContactInformation.astro";
import SlidingTicker from "@components/SlidingTicker.astro";
import FacialThumbnail from "@components/FacialThumbnail.astro";
import GlitchThumbnail from "@components/GlitchThumbnail.astro";
---

<BaseLayout 
  pageTitle="Abraham J. Flores A."
  description="Personal website of Abraham Flores, an AI engineer and independent machine learning researcher"
  pubDate="2026-03-27"
  url={`${import.meta.env.BASE_URL}/`}
  ogImage={import.meta.env.BASE_URL + '/default-og.png'}
>
  <nav>
    <LocalNavLink navPage="">Home</LocalNavLink>
    <LocalNavLink navPage="cv">CV</LocalNavLink>
    <LocalNavLink navPage="blog">Blog</LocalNavLink>
    <ColorThemeToogle />
  </nav>

  <section class="split">
    <div class="left">
      <h1>ABRAHAM<br />FLORES</h1>
      <ContactInformation />
      <p>
        Open Innovation Engineer building AI prototypes for constrained systems, while
        independently researching representation analysis, activation steering, and reproducible machine learning.
      </p>
      <FacialThumbnail />
    </div>

    <div class="right">
      <div class="rightStack">
        <GlitchThumbnail />
        <SlidingTicker 
          slidingText="GO FURTHER GO FURTHER GO FURTHER GO FURTHER"
          time="16"
        /> 
      </div>
    </div>
  </section>
</BaseLayout>
