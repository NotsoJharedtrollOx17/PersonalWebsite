---
/**
 * Page component that is the default landing page (Home) 
 * of the website. THIS IS Astro's STARTING POINT. 
 * DO NOT DELETE!
 */
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import LocalNavLink from "@components/LocalNavLink.astro";
import GlitchInTheSystem from "@images/glitchInTheSystem.png";
---

<BaseLayout pageTitle="Abraham Flores">
  <nav>
    <LocalNavLink navPage="">Home</LocalNavLink>
    <LocalNavLink navPage="cv">CV</LocalNavLink>
  </nav>

  <section class="split">
    <div class="left">
      <h1>ABRAHAM<br />FLORES</h1>
      <p>
        Open Innovation Engineer developing AI-focused PoCs for decision-makers and 
        independently researching decision-making strategies in the age of AI.
      </p>
    </div>

    <div class="right">
      <div class="glitchMedia">
        <Image class="glitchThumbnail" src={GlitchInTheSystem} 
          alt="Thumbnail with blue and green distortions." />
      </div>
    </div>
  </section>
</BaseLayout>
