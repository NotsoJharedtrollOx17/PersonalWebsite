---
/**
 * Page component that is the default landing page (Home) 
 * of the website. THIS IS Astro's STARTING POINT. 
 * DO NOT DELETE!
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import LocalNavLink from "@components/LocalNavLink.astro";
---

<BaseLayout pageTitle="Abraham Flores">
  <nav>
    <LocalNavLink navPage="">Home</LocalNavLink>
    <LocalNavLink navPage="cv">CV</LocalNavLink>
  </nav>

  <section class="split">
    <div class="left">
      <h1>ABRAHAM<br />FLORES</h1>
      <p>Open Innovation Engineer working on AI-focused proof-of-concept development, machine learning, and research systems.</p>
    </div>

    <div class="right">
      <!--
		<img src="/images/architecture.jpg" alt="Architectural abstraction" style="width:100%; height:auto;" />
		-->
    </div>
  </section>
</BaseLayout>
