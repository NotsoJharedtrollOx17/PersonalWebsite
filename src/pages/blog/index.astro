---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import LocalNavLink from "@components/LocalNavLink.astro";
import ColorThemeToogle from "@components/ColorThemeToogle.astro";
import BlogPostLink from "@components/BlogPostLink.astro";
import BlogPostDescription from '@components/BlogPostDescription.astro';
import BlogPostPublicationDate from '@components/BlogPostPublicationDate.astro';
import BlogPostTags from '@components/BlogPostTags.astro';

const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
// Sort by date descending
const sortedPosts = blogPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout   
  title="Blog — Abraham Flores"
  description="Explore articles on AI, systems engineering, and technical research"
>
  <nav class="blogNav">
    <LocalNavLink navPage="">Home</LocalNavLink>
    <LocalNavLink navPage="cv">CV</LocalNavLink>
    <ColorThemeToogle />
  </nav>
  <section class="blog">
    <div class="prose">
      <h1>Blog</h1>
      {sortedPosts.map((post) => (
        <article class="blogPost">
          <h2>
            <BlogPostLink 
              postId={post.id} 
              postTitle={post.data.title} 
            />
          </h2>
          <BlogPostDescription 
            postDescription={post.data.description}
          />
          {/* TODO refactor into individual component */}
          <div class="blogMeta">
            <BlogPostPublicationDate publicationDate={post.data.pubDate}/>
            <BlogPostTags tagList={post.data.tags}/>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>