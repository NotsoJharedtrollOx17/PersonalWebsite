---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import LocalNavLink from "@components/LocalNavLink.astro";
import ColorThemeToogle from "@components/ColorThemeToogle.astro";
import BlogPostSummary from "@components/BlogPostSummary.astro";

const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
// Sort by date descending
const sortedPosts = blogPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout   
  pageTitle="Blog — Abraham J. Flores A."
  description="Explore articles on AI, systems engineering, and technical research"
  pubDate="2026-03-27"
  url={`${import.meta.env.BASE_URL}/blog/`}
  ogImage={import.meta.env.BASE_URL + '/default-og.png'} 
>
  <nav class="blogNav">
    <LocalNavLink navPage="">Home</LocalNavLink>
    <LocalNavLink navPage="cv">CV</LocalNavLink>
    <ColorThemeToogle />
  </nav>
  <section class="blog">
    <div class="prose">
      <h1>BLOG</h1>
      {sortedPosts.map((post) => (
        <BlogPostSummary
          postId={post.id}
          postTitle={post.data.title}
          postDescription={post.data.description}
          publicationDate={post.data.pubDate}
          tagList={post.data.tags}
        />
      ))}
    </div>
  </section>
</BaseLayout>