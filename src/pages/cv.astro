---
/**
 * Page Component that loads the 'cv.md' file into the webpage.
 */
import { getEntry, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import NavigationLink from "@components/NavigationLink.astro";

// [1] Load .src/content/pages/cv.md into page
const cvEntry = await getEntry("pages", "cv");
if (!cvEntry) {
  throw new Error("CV entry not found in the pages collection");
}

// [2] Render the Markdown body to HTML as 'Render' Component
const { Content } = await render(cvEntry);
---

<BaseLayout title="Curriculum Vitae">
  <nav>
    <NavigationLink navItem="">Home</NavigationLink>
  </nav>

  <section class="split">
    <div class="left">
      <h1>{cvEntry.data.title}</h1>
      <p>Open Innovation Engineer · Machine Learning · Research</p>
    </div>

    <div class="right">
      <article>
        <!-- * Rendered Markdown content -->
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>
