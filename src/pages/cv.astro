---
/**
 * Page Component that loads the 'cv.md' file into the webpage.
 */
import { getEntry, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ColorThemeToogle from "@components/ColorThemeToogle.astro";
import SlidingTicker from "@components/SlidingTicker.astro";
import LocalNavLink from "@components/LocalNavLink.astro";
import CVFileLink from "@components/CVFileLink.astro";

// [1] Load .src/content/pages/cv.md into page
const cvEntry = await getEntry("pages", "cv");
if (!cvEntry) {
  throw new Error("CV entry not found in the pages collection");
}

// [2] Render the Markdown body to HTML as 'Content' Component
const { Content } = await render(cvEntry);
---
<BaseLayout pageTitle="Curriculum Vitae">
  <nav>
    <LocalNavLink navPage="">Home</LocalNavLink>
    <ColorThemeToogle />
  </nav>

  <section class="split">
    <div class="left">
      <h1>{cvEntry.data.title}</h1>
      <div class="professionalAttributes">
        <p>Open Innovation Engineer</p>
      </div>
      <CVFileLink cvFileUrl={cvEntry.data.cvPdfUrl} />
      <SlidingTicker 
        slidingText="Data Science Machine Learning Technical Documentation AI INtegration PoC Development Astro JS C/C++ SQL Python PyTorch Tensorflow Scikit-Learn Linux Public Speaking Partner Relationships Management Decision-Making Adaptability Bilingual (English & Spanish)"
        time="40"
      />
    </div>

    <div class="right">
      <article>
        <!-- * Rendered Markdown content -->
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>