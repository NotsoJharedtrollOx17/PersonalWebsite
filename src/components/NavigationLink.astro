---
/**
 * Component that wraps the 'base' astro.config.mjs parameter 
 * and concats said value with the 'navItem' page name.
 * 
 * E.g: if ./src/content/pages/cv.md, then navItem = 'cv'
 */
const { navItem } = Astro.props;

// [1] Appends the '/' if the entry is not blank.
var item: string = '';
if (navItem !== '') {
    item = '/' + navItem;
}
---

<a href={`${import.meta.env.BASE_URL}${item}`}>
    <slot />
</a>
