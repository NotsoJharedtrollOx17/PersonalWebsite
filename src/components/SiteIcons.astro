---
const assetBase = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<link rel="icon" href={`${assetBase}/favicon.ico`} sizes="16x16 32x32 48x48 64x64" />
<link rel="icon" href={`${assetBase}/favicon.svg`} type="image/svg+xml" sizes="any" />
<link rel="apple-touch-icon" href={`${assetBase}/apple-touch-icon.png`} sizes="180x180" />
