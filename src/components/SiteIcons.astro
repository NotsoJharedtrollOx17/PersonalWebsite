---
import faviconSVG from "../assets/brand/af-monogram.svg?url&no-inline";
import faviconICO from "../assets/brand/af-monogram.ico?url&no-inline";

const assetBase = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<link rel="icon" href={faviconICO} sizes="16x16 32x32 48x48 64x64" />
<link rel="icon" href={faviconSVG} type="image/svg+xml" sizes="any" />
<link rel="apple-touch-icon" href={`${assetBase}/apple-touch-icon.png`} sizes="180x180" />
