---
import BlogPostPublicationDate from '@components/BlogPostPublicationDate.astro';
import BlogPostTags from '@components/BlogPostTags.astro';

const { publicationDate, tagList } = Astro.props;
---

<div class="blogMeta">
    <BlogPostPublicationDate publicationDate={publicationDate}/>
    <BlogPostTags tagList={tagList}/>
    <a href="/PersonalWebsite/rss.xml" class="rss-subscribe" title="Subscribe to RSS feed">
        <span>📡</span>
        <span class="sr-only">Subscribe to RSS feed</span>
    </a>
</div>
