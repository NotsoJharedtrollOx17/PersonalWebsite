---
/**
 * Layout Component that sets relevant HTML data and page styling 
 * for the Page Component.
 */
import "@styles/brutalist.css"; // ! ALWAYS IMPORT CSS FILES INTO THE ASTRO FRONTMATTER

const { pageTitle } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- * Prehydration script to load color theme BEFORE everything -->
    <script is:inline>
      // IIFE: Execute this block of logic once, right now
      (function() {
          const root = document.documentElement;
          const storedTheme = localStorage.getItem('theme');

          // [1] ALWAYS respect stored preference first
          if (storedTheme === 'dark') {
            root.classList.add('dark');
            return;
          }

          if (storedTheme === 'light') {
            root.classList.remove('dark');
            return;
          }

          // [2] No stored preference → apply default policy
          const isMobile = navigator.userAgentData?.mobile 
            || /Mobi|Android/i.test(navigator.userAgent);

          if (isMobile) {
            root.classList.add('dark');
            return;
          }

          // [3] Fallback to system preference
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            root.classList.add('dark');
          }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`}/>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Space+Grotesk:wght@600;700;800&display=swap"
    />
    <title>{pageTitle}</title>
  </head>
  
  <body class="page">
    <slot />
  </body>
</html>
