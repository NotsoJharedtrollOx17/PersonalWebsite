---
/**
 * Layout Component that sets relevant HTML data and page styling  * for the Page Component.
 */
import "@styles/brutalist.css"; // ! ALWAYS IMPORT CSS FILES INTO THE ASTRO FRONTMATTER
import { SITE_TITLE, SITE_DESCRIPTION } from '@consts';

const { pageTitle, description, ogImage } = Astro.props;
// Set default values if not provided
const title = pageTitle || SITE_TITLE;
const desc = description || SITE_DESCRIPTION;
const image = ogImage || '/default-og.png';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- * Prehydration script to load color theme BEFORE everything -->
    <script is:inline>
      // IIFE: Execute this block of logic once, right now
      (function() {
          const root = document.documentElement;
          const storedTheme = localStorage.getItem('theme');

          // [1] ALWAYS respect stored preference first
          if (storedTheme === 'dark') {
            root.classList.add('dark');
            return;
          }

          if (storedTheme === 'light') {
            root.classList.remove('dark');
            return;
          }

          // [2] No stored preference → apply default policy
          const isMobile = navigator.userAgentData?.mobile 
            || /Mobi|Android/i.test(navigator.userAgent);

          if (isMobile) {
            root.classList.add('dark');
            return;
          }

          // [3] Fallback to system preference
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            root.classList.add('dark');
          }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`}/>  
    <link rel="preconnect" href="https://fonts.googleapis.com" />  
    <link        rel="stylesheet"  
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Space+Grotesk:wght@600;700;800&display=swap"      />
    
    <!-- SEO & OpenGraph Metadata -->
    <title>{title}</title>
    <meta name="description" content={desc} />
    
    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_TITLE} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
  </head>
  
  <body class="page">
    <slot />
  </body>
</html>