---
/**
 * Layout Component that sets relevant HTML data and page styling  * for the Page Component.
 */
import "@styles/brutalist.css"; // ! ALWAYS IMPORT CSS FILES INTO THE ASTRO FRONTMATTER
import "@styles/fonts.css";
import interFontUrl from "../assets/fonts/inter-latin.woff2?url";
import headingFontUrl from "../assets/fonts/space-grotesk-latin.woff2?url";
import { SITE_TITLE, SITE_DESCRIPTION } from '@consts';
import SiteIcons from "@components/SiteIcons.astro";

const { pageTitle, description, ogImage, pubDate, updatedDate, url } = Astro.props;
// Set default values if not provided
const title = pageTitle || SITE_TITLE;
const desc = description || SITE_DESCRIPTION;
const image = ogImage || `${import.meta.env.BASE_URL}/default-og.png`;
const imageURL = new URL(image, Astro.site).href;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// BlogPosting schema for SEO (only for pages with pubDate)
const schema = pubDate ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": desc,
  "image": imageURL,
  "author": {
    "@type": "Person",
    "name": "Abraham J. Flores A."
  },
  "publisher": {
    "@type": "Organization",
    "name": "Abraham Flores — Personal Website",
    "logo": {
      "@type": "ImageObject",
      "url": new URL(`${import.meta.env.BASE_URL}/logo-512.png`, Astro.site).href
    }
  },
  "datePublished": pubDate,
  "dateModified": updatedDate || pubDate,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": new URL(url || Astro.url.pathname, Astro.site).href
  }
} : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- * Prehydration script to load color theme BEFORE everything -->
    <script is:inline>
      // IIFE: Execute this block of logic once, right now
      (function() {
          const root = document.documentElement;
          const storedTheme = localStorage.getItem('theme');

          // [1] ALWAYS respect stored preference first
          if (storedTheme === 'dark') {
            root.classList.add('dark');
            return;
          }

          if (storedTheme === 'light') {
            root.classList.remove('dark');
            return;
          }

          // [2] No stored preference → apply default policy
          const isMobile = navigator.userAgentData?.mobile 
            || /Mobi|Android/i.test(navigator.userAgent);

          if (isMobile) {
            root.classList.add('dark');
            return;
          }

          // [3] Fallback to system preference
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            root.classList.add('dark');
          }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <SiteIcons />
    <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingFontUrl} as="font" type="font/woff2" crossorigin />
    
    <!-- SEO & OpenGraph Metadata -->
    <title>{title}</title>
    <meta name="description" content={desc} />
    
    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_TITLE} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
        <!-- Article Schema (JSON-LD) for blog posts -->
    {schema && (<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />)}
  </head>
  
  <body class="page">
    <slot />
  </body>
</html>
